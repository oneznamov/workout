# Postgres connection string (any Postgres 14+; Neon via the Vercel Marketplace works out of the box)
DATABASE_URL=postgres://user:pass@host/db
# Optional: a direct (non-pooled) connection for migrations; falls back to DATABASE_URL
# DATABASE_URL_UNPOOLED=postgres://user:pass@host/db

# Random 32+ byte secret: signs session cookies and encrypts stored AI keys and push keys.
# Generate once with `openssl rand -hex 32` and keep it — changing it signs everyone out
# and makes saved AI keys unreadable.
AUTH_SECRET=

# Optional: the time zone training days are counted in (default: app.config.ts → timeZone)
# NEXT_PUBLIC_APP_TZ=Europe/Kyiv

# Only for the demo (`pnpm demo:*`): an EMPTY throwaway database, never the real one.
# Can also live in a git-ignored `.env.demo` file.
# DEMO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/workout_demo
